---
import Pulse from "./Pulse.astro";
import { formatNumber, dateTimeNo } from "../lib/format.mjs";

interface Props {
  generated: any;
}

const { generated } = Astro.props;
const { stats, syncedAt } = generated;

/* De fire første tallene synkes automatisk; produktteam og deployer er
   Nav-interne cirkatall uten API-kilde (jf. PRD §4.2). */
const figures = [
  { icon: "i-repo", value: formatNumber(stats.publicRepos), label: "åpne repoer på GitHub" },
  { icon: "i-commit", value: formatNumber(stats.commitsLast7Days), label: "commits de siste sju dagene" },
  { icon: "i-pr", value: formatNumber(stats.prsLast30Days), label: "pull requests de siste 30 dagene" },
  { icon: "i-people", value: "~90", label: "produktteam som bygger i det åpne" },
  { icon: "i-deploy", value: `~${formatNumber(2400)}`, label: "produksjonsdeployer i uka" },
  { icon: "i-download", value: formatNumber(stats.npmDownloadsLastMonth), label: "nedlastinger av Aksel-ikonene siste måned" },
];
---

<section class="stats" aria-label="Nøkkeltall og aktivitet">
  <div class="container">
    <h2 class="sr-only">Tallene</h2>
    <div class="stats-grid">
      {figures.map((f) => (
        <div class="stat">
          <svg class="icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href={`#${f.icon}`} /></svg>
          <p class="figure nums">{f.value}</p>
          <p class="label">{f.label}</p>
        </div>
      ))}
    </div>

    <Pulse generated={generated} />

    <p class="stamp detail">Tallene fra GitHub og npm hentes automatisk&nbsp;— bottene bidrar også. Produktteam og deployer er Nav-interne cirkatall. Sist oppdatert {dateTimeNo(syncedAt)}.</p>
  </div>
</section>
