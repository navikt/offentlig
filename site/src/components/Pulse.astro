---
import { relativeTimeNo } from "../lib/format.mjs";

interface Props {
  generated: any;
}

const { generated } = Astro.props;
const { heatmap, languages, recentlyUpdated, syncedAt } = generated;

/* Språkfarger til den klientside-oppfriskede feeden: alt synken kjenner
   (org-språkene + feedens egne), så nye repoer som dukker opp i løpet av
   dagen som regel treffer en kjent farge — ellers nøytral prikk. */
const langColorMap: Record<string, string> = {};
for (const e of languages?.entries ?? []) if (e.color) langColorMap[e.name] = e.color;
for (const r of recentlyUpdated ?? []) if (r.language && r.languageColor) langColorMap[r.language] = r.languageColor;

/* ---- Aktivitetskart: statisk genererte celler fra ekte commit-data ----
   Synken leverer org-vide commits per dag (heatmap.days, kun standard-
   grenene — commit-search indekserer ikke andre grener). Rutenettet har
   mandag øverst: nøyaktig 52 kolonner (uker) som slutter på gårsdagen
   regnet fra synk-tidspunktet — aldri fremtidsceller, aldri et påbegynt
   døgn. */
const DAY_MS = 86_400_000;
type Cell = { count: number; level: number };
let columns: Cell[][] = [];
if (heatmap?.days?.length) {
  const byDay = new Map<number, number>(); // epoch-dag (UTC) → commits
  for (const d of heatmap.days) {
    byDay.set(Math.floor(Date.parse(d.date) / DAY_MS), d.count);
  }

  const endDay = Math.floor(new Date(syncedAt).getTime() / DAY_MS) - 1; // i går (UTC)
  const dow = (endDay + 4) % 7; // epoch-dag 0 = torsdag; 0 = søndag … 6 = lørdag
  const lastMonday = endDay - ((dow + 6) % 7);
  const firstMonday = lastMonday - 51 * 7;

  const counts: number[][] = [];
  for (let col = 0; col < 52; col++) {
    const days: number[] = [];
    for (let row = 0; row < 7; row++) {
      const day = firstMonday + col * 7 + row;
      if (day > endDay) break; // kun i siste kolonne — ingen fremtid
      days.push(byDay.get(day) ?? 0);
    }
    counts.push(days);
  }

  const nonzero = counts
    .flat()
    .filter((n: number) => n > 0)
    .sort((a: number, b: number) => a - b);
  const q = (p: number) => nonzero[Math.min(Math.floor(p * nonzero.length), nonzero.length - 1)] ?? 1;
  const [q1, q2, q3] = [q(0.25), q(0.5), q(0.75)];
  const level = (n: number) => (n === 0 ? 0 : n <= q1 ? 1 : n <= q2 ? 2 : n <= q3 ? 3 : 4);
  columns = counts.map((days) => days.map((count) => ({ count, level: level(count) })));
}

/* ---- Språkfordeling: prosent av aktive repoer, «Annet» fyller opp til 100 ---- */
const langTotal = languages.entries.reduce((s: number, e: any) => s + e.count, 0);
const named = languages.entries
  .filter((e: any) => e.name !== "Annet")
  .map((e: any) => ({ ...e, pct: Math.round((e.count / langTotal) * 100) }));
const annet = {
  name: "Annet",
  color: null,
  pct: 100 - named.reduce((s: number, e: any) => s + e.pct, 0),
};
const langs = [...named, annet];
const langLabel =
  "Fordeling av primærspråk i åpne repoer: " +
  langs
    .map((l, i) => `${l.name === "Annet" ? "annet" : l.name} ${l.pct}${i === 0 ? " prosent" : ""}`)
    .join(", ");
---

<div class="pulse">
  <div>
    <h3>Commits siste 52 uker</h3>
    {columns.length > 0 && (
      <>
        <div class="heatmap-scroll">
          <div class="heatmap" role="img" aria-label="Aktivitetskart: commits på standardgrenene i alle åpne navikt-repoer per dag de siste 52 ukene">
            {columns.map((days) =>
              days.map((c) => <i class={c.level ? `l${c.level}` : undefined} title={`${c.count} ${c.count === 1 ? "commit" : "commits"}`}></i>)
            )}
          </div>
        </div>
        <div class="heatmap-legend detail" aria-hidden="true">
          <span>Mindre</span><i></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i><span>Mer</span>
        </div>
        <p class="caption detail">Commits på standardgrenene i alle åpne navikt-repoer, dag for dag siste 52 uker.</p>
      </>
    )}

    <div class="langs">
      <h3>Språkene</h3>
      <div class="lang-bar" role="img" aria-label={langLabel}>
        {langs.map((l) => (
          <i style={`flex:${l.pct};background:${l.color ?? "var(--border-strong)"}`}></i>
        ))}
      </div>
      <ul class="lang-legend detail nums" aria-hidden="true">
        {langs.map((l) => (
          <li><span class="lang-dot" style={`background:${l.color ?? "var(--border-strong)"}`}></span>{l.name} {l.pct}&#8239;%</li>
        ))}
      </ul>
      <p class="caption detail">JVM-tungt bakover, TypeScript forover&nbsp;— og litt av alt.</p>
    </div>
  </div>
  <div>
    <h3>Nylig oppdatert</h3>
    <ul class="feed nums" data-live-feed>
      {recentlyUpdated.map((r: any) => (
        <li>
          <span><span class="lang-dot" style={`background:${r.languageColor ?? "var(--border-strong)"}`}></span><a href={r.url}>{r.name}</a></span>
          <span class="when detail">{relativeTimeNo(r.pushedAt, syncedAt)}</span>
        </li>
      ))}
    </ul>
    <p class="caption detail" data-live-caption>Levende produktutvikling, åpent.</p>
  </div>
</div>

{/* Progressiv forbedring: listen over er bygget fra nattlig synk og står
    seg uten JavaScript. I nettleseren friskes den opp direkte fra GitHubs
    åpne REST-API (uautentisert, CORS: *, 60 kall/time per IP) — feiler
    kallet (kvote, nettverk), beholdes øyeblikksbildet i stillhet.
    NB: kallet går fra besøkendes nettleser til api.github.com — flagget
    for personvernvurdering før lansering (PRD §5.7). */}
<script type="application/json" id="lang-colors" set:html={JSON.stringify(langColorMap)} />
<script>
  const feed = document.querySelector("[data-live-feed]");
  const caption = document.querySelector("[data-live-caption]");
  const colors = JSON.parse(document.getElementById("lang-colors")?.textContent ?? "{}");

  /* Samme norske relativtid som lib/format.mjs — entall «ett»/«én». */
  function relTime(iso: string): string {
    const minutes = Math.floor((Date.now() - Date.parse(iso)) / 60_000);
    if (minutes < 1) return "for under ett minutt siden";
    if (minutes === 1) return "for ett minutt siden";
    if (minutes < 60) return `for ${minutes} minutter siden`;
    const hours = Math.floor(minutes / 60);
    if (hours === 1) return "for én time siden";
    if (hours < 24) return `for ${hours} timer siden`;
    const days = Math.floor(hours / 24);
    if (days === 1) return "for én dag siden";
    return `for ${days} dager siden`;
  }

  async function refresh() {
    if (!feed) return;
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 5000);
    try {
      const res = await fetch(
        "https://api.github.com/orgs/navikt/repos?sort=pushed&direction=desc&per_page=12",
        { headers: { Accept: "application/vnd.github+json" }, signal: ctrl.signal },
      );
      if (!res.ok) return; // kvote/feil → behold øyeblikksbildet
      const repos = (await res.json())
        .filter((r: any) => !r.archived && !r.fork)
        .slice(0, 6);
      if (repos.length < 6) return;

      feed.replaceChildren(
        ...repos.map((r: any) => {
          const li = document.createElement("li");
          const left = document.createElement("span");
          const dot = document.createElement("span");
          dot.className = "lang-dot";
          dot.style.background = colors[r.language] ?? "var(--border-strong)";
          const a = document.createElement("a");
          a.href = r.html_url;
          a.textContent = r.name;
          left.append(dot, a);
          const when = document.createElement("span");
          when.className = "when detail";
          when.textContent = relTime(r.pushed_at);
          li.append(left, when);
          return li;
        }),
      );
      if (caption) caption.textContent = "Levende produktutvikling, åpent — hentet fra GitHub nå nettopp.";
    } catch {
      /* nettverk/timeout → behold øyeblikksbildet */
    } finally {
      clearTimeout(timer);
    }
  }
  refresh();
</script>
