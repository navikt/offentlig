---
import Layout from "../../layouts/Layout.astro";
import Icons from "../../components/Icons.astro";
import ProsjektHeader from "../../components/ProsjektHeader.astro";
import ProsjektFooter from "../../components/ProsjektFooter.astro";

import generated from "../../data/generated.json";

/* Bespoke landingsside (PRD: håndlaget, aldri generert fra mal).
   Motiv: brytertavla — bryterne er det enkle; å drifte systemet bak er jobben. */
const data = (generated.repos as any)["nais/unleasherator"];
---

<Layout
  title="unleasherator — funksjonsbrytere på bestilling"
  description="Kubernetes-operatør som drifter Unleash-instanser, deler ut API-tokens og kobler clustre sammen. Åpen kildekode fra Nav, bygd for gjenbruk."
>
  <ProsjektHeader navn="unleasherator" />
  <main id="hoved">
    <Icons />

    <section class="p-hero">
      <div class="container">
        <div class="hero-copy">
          <p class="eyebrow">Fra Nais-plattformen · Bygd for gjenbruk</p>
          <h1>unleasherator</h1>
          <p class="thesis">Funksjonsbrytere er enkle. Å drifte Unleash er jobben — unleasherator tar den.</p>
          <p class="ingress">Unleash er et åpent system for funksjonsbrytere, opprinnelig laget i Norge. Å skru en bryter av og på tar sekunder — men noen må kjøre serveren bak. unleasherator er en Kubernetes-operatør som setter opp Unleash-instanser, deler ut API-tokens og kobler clustre sammen, slik at team kan bytte funksjoner i stedet for å drifte servere.</p>
          <div class="cta-row">
            <a class="btn" href="https://github.com/nais/unleasherator">Kom i gang på GitHub<svg class="ext-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-external" /></svg></a>
            <a class="btn btn-quiet" href="#slik-virker-det">Slik virker det</a>
          </div>
          <p class="p-meta detail nums">
            {data?.language && (
              <>
                <span><span class="lang-dot" style={`background:${data.languageColor ?? "var(--border-strong)"}`}></span>{data.language}</span>
                <span class="sep">·</span>
              </>
            )}
            <span>MIT-lisens</span>
            <span class="sep">·</span>
            <span>Kubernetes-operatør</span>
          </p>
        </div>

        <div class="hero-visual">
          <figure class="board" role="img" aria-label="En brytertavle med fire funksjonsbrytere: ny-soknadsdialog på, digital-postkasse på, forenklet-innlogging av, mobil-forsteside på.">
            <div class="board-bar">
              <span class="fname">funksjonsbrytere</span>
              <span class="kind-chip">team: mitt-team</span>
            </div>
            <ul class="switches">
              <li class="row" id="flip">
                <span class="flag">ny-soknadsdialog</span>
                <span class="state" data-on="på" data-off="av"></span>
                <span class="sw" aria-hidden="true"><span class="knob"></span></span>
              </li>
              <li class="row on">
                <span class="flag">digital-postkasse</span>
                <span class="state" data-on="på" data-off="av"></span>
                <span class="sw" aria-hidden="true"><span class="knob"></span></span>
              </li>
              <li class="row">
                <span class="flag">forenklet-innlogging</span>
                <span class="state" data-on="på" data-off="av"></span>
                <span class="sw" aria-hidden="true"><span class="knob"></span></span>
              </li>
              <li class="row on">
                <span class="flag">mobil-forsteside</span>
                <span class="state" data-on="på" data-off="av"></span>
                <span class="sw" aria-hidden="true"><span class="knob"></span></span>
              </li>
            </ul>
          </figure>
          <p class="board-note">Så enkelt er det for teamet. Bak hver bryter står en Unleash-server som må installeres, oppdateres og holdes i live — det er den delen operatøren tar.</p>
        </div>
      </div>
    </section>

    <section class="section p-manages" id="hva-den-styrer">
      <div class="container">
        <div class="section-head">
          <h2>Hva den styrer</h2>
          <p class="ingress">unleasherator utvider Kubernetes med fire egne ressurstyper. Du beskriver hva du vil ha; operatøren avstemmer virkeligheten mot beskrivelsen.</p>
          <div class="crd-chips">
            <span class="kind-chip">Unleash</span>
            <span class="kind-chip">ApiToken</span>
            <span class="kind-chip">RemoteUnleash</span>
            <span class="kind-chip">ReleaseChannel</span>
          </div>
        </div>
        <dl class="kv">
          <div class="kv-row"><dt>Unleash</dt><dd>En komplett Unleash-instans i clusteret — deployment, ingress og tilkobling til databasen. Operatøren driver hele livsløpet.</dd></div>
          <div class="kv-row"><dt>ApiToken</dt><dd>En API-token mot en Unleash-instans, klargjort og lagt i en Kubernetes-secret der applikasjonen leser den.</dd></div>
          <div class="kv-row"><dt>RemoteUnleash</dt><dd>En kobling til en Unleash-instans som kjører et annet sted, autentisert med en admin-token fra en secret. Slik når flere clustre samme brytere.</dd></div>
          <div class="kv-row"><dt>ReleaseChannel</dt><dd>En felles oppdateringskanal som ruller ut nye Unleash-versjoner på tvers av instansene dine, med strategi for helsesjekk og tilbakerulling.</dd></div>
        </dl>
        <p class="fine kv-foot">Federasjon — å dele brytere mellom instanser — settes opp som et felt på <code>Unleash</code>-ressursen, ikke som en egen ressurstype.</p>
      </div>
    </section>

    <section class="section p-how" id="slik-virker-det">
      <div class="container">
        <div class="section-head">
          <h2>Slik får teamet en Unleash-instans</h2>
          <p class="ingress">Ingen manuelle servere, ingen tokens sendt på e-post. Teamet ber om det de trenger med noen få ressurser, og operatøren gjør resten.</p>
        </div>
        <ol class="steps" style="list-style:none">
          <li class="step">
            <p class="num">Steg 1</p>
            <h3>Be om en instans</h3>
            <p>Legg en <code>Unleash</code>-ressurs i clusteret og pek den mot databasen. Operatøren setter opp Unleash-serveren og holder den kjørende.</p>
          </li>
          <li class="step">
            <p class="num">Steg 2</p>
            <h3>Få en token</h3>
            <p>Legg til en <code>ApiToken</code>. Operatøren oppretter tokenen mot instansen og legger den i en secret applikasjonen kan lese.</p>
          </li>
          <li class="step">
            <p class="num">Steg 3</p>
            <h3>Del på tvers</h3>
            <p>Skal andre clustre bruke samme brytere, peker du en <code>RemoteUnleash</code> mot instansen. <code>ReleaseChannel</code> holder versjonene i takt.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section p-start" id="kom-i-gang">
      <div class="container">
        <div class="section-head">
          <h2>Kom i gang</h2>
          <p class="ingress">Prosjektet er bygd med Kubebuilder og følger vanlig operatør-oppsett. Installer ressurstypene, rull ut kontrolleren, og legg inn eksemplene.</p>
        </div>
        <div class="cmds">
          <figure class="cmd">
            <figcaption>Installer ressurstypene (CRD-ene)</figcaption>
            <pre><code><span class="cprompt">$</span> make install</code></pre>
          </figure>
          <figure class="cmd">
            <figcaption>Bygg, publiser og rull ut kontrolleren</figcaption>
            <pre><code><span class="cprompt">$</span> make docker-build docker-push IMG=&lt;registry&gt;/unleasherator:tag
<span class="cprompt">$</span> make deploy IMG=&lt;registry&gt;/unleasherator:tag</code></pre>
          </figure>
          <figure class="cmd">
            <figcaption>Prøv de medfølgende eksemplene</figcaption>
            <pre><code><span class="cprompt">$</span> kubectl apply -f config/samples/</code></pre>
          </figure>
        </div>
        <div class="prereq">
          <h3>Det du trenger</h3>
          <ul>
            <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Et Kubernetes-cluster med <code>kubectl</code> satt opp</li>
            <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>En PostgreSQL-database som Unleash-instansene lagrer dataene sine i</li>
            <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Docker hvis du vil bygge ditt eget operatør-image</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section p-adopt" id="ta-i-bruk">
      <div class="container">
        <div class="section-head">
          <h2>Gjenbruk i egen virksomhet</h2>
          <p class="ingress">Koden er åpen, men vær ærlig om hva du overtar før du tar den i drift.</p>
        </div>
        <div class="panel">
          <p class="fine">MIT-lisensiert og fritt å bruke. Vi lover ingen support-SLA, men issues og pull requests er velkomne. Driften er ditt ansvar.</p>
          <p class="fine">unleasherator er bygd for og driftes på Nais-plattformen. Den er ikke testet i andre miljøer, så regn med litt egeninnsats hvis du vil kjøre den i eget cluster.</p>
          <p class="adopter-note"><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Åpen kildekode fra Nav</p>
        </div>
      </div>
    </section>
  </main>
  <ProsjektFooter repo="nais/unleasherator" lenker={[{ href: "https://nais.io", tekst: "nais.io" }, { href: "https://www.getunleash.io", tekst: "getunleash.io" }]} />
</Layout>

<style>
  .p-hero { padding: 4rem 0; }
  .p-hero .container { display: grid; gap: 3rem; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 1rem; max-width: var(--prose); }
  .p-hero h1 { font-size: 3rem; letter-spacing: -0.01em; }
  .thesis { font-size: 1.375rem; font-weight: 600; line-height: 1.35; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .btn-quiet { background: transparent; color: var(--text); border: 1px solid var(--border-strong); }
  .btn-quiet:hover { background: var(--bg-subtle); color: var(--text); border-color: var(--text-subtle); }
  .p-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 0.75rem; }
  .p-meta .sep { color: var(--border-strong); }
  @media (min-width: 768px) { .p-hero { padding: 6rem 0; } .p-hero h1 { font-size: 3.5rem; } }
  @media (min-width: 1024px) { .p-hero .container { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  /* Brytertavla */
  .hero-visual { display: flex; flex-direction: column; gap: 1rem; }
  .board { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .board-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.625rem 1rem; border-bottom: 1px solid var(--border); background: var(--bg-subtle); }
  .board-bar .fname { font-family: var(--mono); font-size: 0.8125rem; color: var(--text-subtle); }
  .kind-chip { font-family: var(--mono); font-size: 0.75rem; padding: 0.125rem 0.5rem; border-radius: var(--radius-s); background: var(--tag-info-bg); color: var(--tag-info-text); white-space: nowrap; }
  .switches { list-style: none; display: flex; flex-direction: column; }
  .row { display: flex; align-items: center; gap: 1rem; padding: 0.875rem 1rem; }
  .row + .row { border-top: 1px solid var(--border); }
  .row .flag { font-family: var(--mono); font-size: 0.9375rem; color: var(--text); }
  .row .state { margin-left: auto; font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--text-subtle); min-width: 1.75rem; text-align: right; text-transform: uppercase; letter-spacing: 0.04em; }
  .row .state::after { content: attr(data-off); }
  .row.on .state { color: var(--info-strong); font-weight: 600; }
  .row.on .state::after { content: attr(data-on); }
  .sw { position: relative; width: 2.75rem; height: 1.5rem; flex-shrink: 0; border-radius: 999px; background: var(--border-strong); transition: background 320ms ease; }
  .sw .knob { position: absolute; top: 0.1875rem; left: 0.1875rem; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); transition: transform 320ms cubic-bezier(0.4, 0.9, 0.4, 1.2); }
  .row.on .sw { background: var(--accent); }
  .row.on .sw .knob { transform: translateX(1.25rem); }
  .board-note { font-size: 0.9375rem; color: var(--text-subtle); max-width: 34rem; }
  @media (prefers-reduced-motion: reduce) { .sw, .sw .knob { transition: none; } }

  .p-manages { border-top: 1px solid var(--border); }
  .crd-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .kv { border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .kv-row { display: grid; grid-template-columns: minmax(10rem, auto) 1fr; }
  .kv-row + .kv-row { border-top: 1px solid var(--border); }
  .kv-row dt { font-family: var(--mono); font-size: 0.875rem; padding: 0.875rem 1rem; background: var(--bg-subtle); color: var(--text); border-right: 1px solid var(--border); }
  .kv-row dd { font-size: 1rem; padding: 0.875rem 1rem; color: var(--text-subtle); }
  .kv-foot { margin-top: 1rem; }
  .kv-foot code, .step code, .prereq code { font-family: var(--mono); font-size: 0.875em; background: var(--tint-info); color: var(--info-strong); padding: 0.0625rem 0.3125rem; border-radius: var(--radius-s); }
  @media (max-width: 639px) {
    .kv-row { grid-template-columns: 1fr; }
    .kv-row dt { border-right: none; border-bottom: 1px solid var(--border); }
  }

  .p-how { background: var(--bg-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .steps { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .step { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .step .num { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--info-strong); }
  .step h3 { font-size: 1.1875rem; }
  .step p { color: var(--text-subtle); font-size: 1.0625rem; }

  .cmds { display: flex; flex-direction: column; gap: 1rem; }
  .cmd { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .cmd figcaption { padding: 0.625rem 1rem; border-bottom: 1px solid var(--border); background: var(--bg-subtle); font-size: 0.875rem; color: var(--text-subtle); }
  .cmd pre { padding: 1rem; overflow-x: auto; font-family: var(--mono); font-size: 0.875rem; line-height: 1.7; color: var(--text); }
  .cmd .cprompt { color: var(--text-subtle); user-select: none; padding-right: 0.5rem; }

  .prereq { margin-top: 2rem; background: var(--tint-info); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 1.75rem; }
  .prereq h3 { font-size: 1.1875rem; margin-bottom: 0.875rem; }
  .prereq ul { list-style: none; display: flex; flex-direction: column; gap: 0.625rem; }
  .prereq li { display: flex; gap: 0.625rem; align-items: baseline; color: var(--text-subtle); font-size: 1.0625rem; }

  .p-adopt { background: var(--tint-info); border-top: 1px solid var(--border); }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 2rem; display: flex; flex-direction: column; gap: 0.875rem; max-width: var(--prose); }
  .panel .fine { font-size: 1rem; color: var(--text-subtle); }
  .check-icon { color: var(--accent); flex-shrink: 0; transform: translateY(2px); }
  .adopter-note { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: var(--info-strong); font-weight: 600; }
</style>

<script is:inline>
  // Én bryter slås på i det siden lastes; reduced-motion viser sluttbildet direkte.
  (function () {
    var flip = document.getElementById("flip");
    if (!flip) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      flip.classList.add("on");
    } else {
      setTimeout(function () { flip.classList.add("on"); }, 900);
    }
  })();
</script>
</content>
</invoke>
