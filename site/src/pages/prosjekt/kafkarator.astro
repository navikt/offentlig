---
import Layout from "../../layouts/Layout.astro";
import Icons from "../../components/Icons.astro";
import ProsjektHeader from "../../components/ProsjektHeader.astro";
import ProsjektFooter from "../../components/ProsjektFooter.astro";

import generated from "../../data/generated.json";

/* Bespoke landingsside (PRD: håndlaget, aldri generert fra mal).
   Motiv: før/etter — saksgangen for en Kafka-topic blir til én fil
   teamet eier, der tilgangslisten bor i samme fil som topicen. */
const data = (generated.repos as any)["nais/kafkarator"];
---

<Layout
  title="kafkarator — selvbetjening for Kafka-topics på Aiven"
  description="Kubernetes-operatør som gjør en Kafka-topic til en fil i repoet ditt: du beskriver topicen og tilgangene, operatøren oppretter dem på Aiven. Åpen kildekode fra Nav."
>
  <ProsjektHeader navn="kafkarator" />
  <main id="hoved">
    <Icons />

    <section class="p-hero">
      <div class="container">
        <div class="hero-copy">
          <p class="eyebrow">Fra Nais-plattformen · Bygd for gjenbruk</p>
          <h1>kafkarator</h1>
          <p class="thesis">En Kafka&#8209;topic er en fil i repoet ditt.</p>
          <p class="ingress">Kafkarator gjør Kafka-byråkratiet om til én ressurs teamet ditt eier — slutt på saker til plattformteamet, admin-paneler og ACL-forespørsler. Du beskriver topicen i YAML, og operatøren oppretter den på Aiven og setter opp tilgangene. Tilgangslisten bor i samme fil som topicen: en pull request er hele prosessen.</p>
          <div class="cta-row">
            <a class="btn" href="https://github.com/nais/kafkarator">Kom i gang på GitHub<svg class="ext-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-external" /></svg></a>
            <a class="btn btn-quiet" href="#slik-virker-det">Slik virker det</a>
          </div>
          <p class="p-meta detail nums">
            {data?.language && (
              <>
                <span><span class="lang-dot" style={`background:${data.languageColor ?? "var(--border-strong)"}`}></span>{data.language}</span>
                <span class="sep">·</span>
              </>
            )}
            <span>MIT-lisens</span>
            <span class="sep">·</span>
            <span>Kubernetes-operatør</span>
            <span class="sep">·</span>
            <span>Aiven Kafka</span>
          </p>
        </div>

        <figure class="ba" aria-label="Før og etter: fra saksgang til én Topic-ressurs der tilgangene ligger i samme fil">
          <div class="ba-col ba-before">
            <p class="ba-label">Før — saksgangen</p>
            <ul class="checklist" id="checklist">
              <li>Opprett sak til plattformteamet</li>
              <li>Vent på at topicen blir satt opp</li>
              <li>Be om ACL for konsumenten</li>
              <li>Be om ACL for produsenten</li>
              <li>Få tilsendt sertifikat og nøkkel</li>
              <li>Roter dem før de utløper</li>
            </ul>
          </div>

          <div class="ba-arrow" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </div>

          <div class="ba-col ba-after">
            <p class="ba-label">Etter — én fil</p>
            <div class="manifest">
              <div class="manifest-bar">
                <span class="fname">topic.yaml</span>
                <span class="kind-chip">kind: Topic</span>
              </div>
              <pre><code><span class="yk">apiVersion</span><span class="yp">:</span> kafka.nais.io/v1
<span class="yk">kind</span><span class="yp">:</span> Topic
<span class="yk">metadata</span><span class="yp">:</span>
  <span class="yk">name</span><span class="yp">:</span> min-topic
  <span class="yk">namespace</span><span class="yp">:</span> mitt-team
<span class="yk">spec</span><span class="yp">:</span>
  <span class="yk">pool</span><span class="yp">:</span> <span class="ys">nav-dev</span>
  <span class="yk">config</span><span class="yp">:</span>
    <span class="yk">partitions</span><span class="yp">:</span> 3
    <span class="yk">replication</span><span class="yp">:</span> 2
<span class="acl-hl">  <span class="yk">acl</span><span class="yp">:</span>
    <span class="yp">-</span> <span class="yk">access</span><span class="yp">:</span> <span class="ys">readwrite</span>
      <span class="yk">application</span><span class="yp">:</span> <span class="ys">min-app</span>
      <span class="yk">team</span><span class="yp">:</span> <span class="ys">mitt-team</span>
    <span class="yp">-</span> <span class="yk">access</span><span class="yp">:</span> <span class="ys">read</span>
      <span class="yk">application</span><span class="yp">:</span> <span class="ys">konsument</span>
      <span class="yk">team</span><span class="yp">:</span> <span class="ys">annet-team</span></span></code></pre>
            </div>
            <p class="ba-note"><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Tilgangslisten bor i samme fil som topicen.</p>
          </div>
        </figure>
      </div>
    </section>

    <section class="section p-how" id="slik-virker-det">
      <div class="container">
        <div class="section-head">
          <h2>Slik virker det</h2>
          <p class="ingress">Kafkarator definerer én egen ressurstype, <code>kafka.nais.io/Topic</code>. Når du oppretter eller endrer den, oversetter operatøren den til topics og ACL-oppføringer på Aiven-hostet Kafka.</p>
        </div>
        <ol class="steps" style="list-style:none">
          <li class="step">
            <p class="num">Steg 1</p>
            <h3>Beskriv topicen</h3>
            <p>Legg en <code>Topic</code>-ressurs i clusteret med antall <code>partitions</code>, <code>replication</code> og en <code>acl</code>-liste. Hver oppføring peker på en <code>application</code> og et <code>team</code>, med <code>access</code> lik read, write eller readwrite.</p>
          </li>
          <li class="step">
            <p class="num">Steg 2</p>
            <h3>Operatøren synkroniserer</h3>
            <p>Kafkarator oppdager ressursen og oppretter topicen og ACL-oppføringene i Aiven-poolen du oppga. Endrer du filen, følger Aiven etter — synkroniseringen er automatisk.</p>
          </li>
          <li class="step">
            <p class="num">Steg 3</p>
            <h3>Appene kobler seg på</h3>
            <p>Hver <code>application</code> i lista får tilgang gjennom en Kubernetes-secret med TLS-legitimasjon i sitt eget namespace. Ingen sertifikater sendes på e-post, ingen tilgang gis utenfor filen.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section p-secret">
      <div class="container">
        <div class="section-head">
          <h2>Det applikasjonen får</h2>
          <p class="ingress">En app med Kafka aktivert leser alt den trenger fra en secret som plattformen legger i namespacet. Ingen tilkoblingsstreng limes inn for hånd. Variablene under er dokumentert i <a href="https://docs.nais.io/persistence/kafka/reference/environment-variables/">Nais Kafka-dokumentasjonen</a>.</p>
          <div class="crd-chips">
            <span class="kind-chip">TLS-sertifikat</span>
            <span class="kind-chip">Broker-adresser</span>
            <span class="kind-chip">Keystore / truststore</span>
          </div>
        </div>
        <dl class="kv">
          <div class="kv-row"><dt>KAFKA_BROKERS</dt><dd>Kommaseparert liste av HOST:PORT-par til Kafka-brokerne</dd></div>
          <div class="kv-row"><dt>KAFKA_CERTIFICATE</dt><dd>Klientsertifikat for å koble til brokerne (som streng; <code>KAFKA_CERTIFICATE_PATH</code> gir samme som fil)</dd></div>
          <div class="kv-row"><dt>KAFKA_PRIVATE_KEY</dt><dd>Privat nøkkel til klientsertifikatet (som streng; <code>KAFKA_PRIVATE_KEY_PATH</code> som fil)</dd></div>
          <div class="kv-row"><dt>KAFKA_CA</dt><dd>CA-sertifikatet som validerer brokerne (som streng; <code>KAFKA_CA_PATH</code> som fil)</dd></div>
          <div class="kv-row"><dt>KAFKA_CREDSTORE_PASSWORD</dt><dd>Passordet som låser opp keystore og truststore</dd></div>
          <div class="kv-row"><dt>KAFKA_KEYSTORE_PATH · KAFKA_TRUSTSTORE_PATH</dt><dd>PKCS#12-keystore og JKS-truststore for Java-klienter</dd></div>
          <div class="kv-row"><dt>KAFKA_SCHEMA_REGISTRY</dt><dd>URL til schema registry (med egne <code>_USER</code>- og <code>_PASSWORD</code>-variabler)</dd></div>
          <div class="kv-row"><dt>AIVEN_SECRET_UPDATED</dt><dd>Tidsstempel for når legitimasjonen sist ble skrevet</dd></div>
        </dl>
      </div>
    </section>

    <section class="section p-start" id="kom-i-gang">
      <div class="container">
        <div class="section-head">
          <h2>Kom i gang</h2>
          <p class="ingress">Deploy operatøren med Helm-charten i repoet, og opprett din første topic. Alt annet er en pull request.</p>
        </div>
        <div class="cmd">
          <pre><code><span class="cm"># 1 · installer operatøren i clusteret</span>
helm install kafkarator charts/kafkarator

<span class="cm"># 2 · opprett topicen (og tilgangene) fra filen</span>
kubectl apply -f topic.yaml</code></pre>
        </div>
      </div>
    </section>

    <section class="section p-adopt" id="ta-i-bruk">
      <div class="container">
        <div class="section-head">
          <h2>Ta den i bruk i din virksomhet</h2>
          <p class="ingress">Kafkarator er ikke bundet til Nav — men vær ærlig om forutsetningen: den er bygd for Aiven-hostet Kafka, ikke for selvdrevne Kafka-klynger.</p>
        </div>
        <div class="cols">
          <div class="panel">
            <h3>Det du trenger</h3>
            <ul>
              <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Et Kubernetes-cluster der operatøren og applikasjonene dine kjører</li>
              <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>En Aiven-konto med minst én Kafka-tjeneste — <code>pool</code> i ressursen peker på denne</li>
              <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>En YAML-fil per topic — det er hele grensesnittet</li>
            </ul>
          </div>
          <div class="panel">
            <h3>Det du kan forvente</h3>
            <p class="fine">MIT-lisensiert og fritt å bruke. Vi lover ingen support-SLA, men issues og pull requests er velkomne — koden driftes daglig i Nav, så den blir vedlikeholdt uansett.</p>
            <p class="fine">Er du ikke på Aiven, passer ikke kafkarator direkte. Da er den likevel et konkret forbilde for hvordan selvbetjening av topics kan se ut.</p>
            <p class="adopter-note"><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Klar for enhver norsk etat på Aiven</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <ProsjektFooter repo="nais/kafkarator" lenker={[{ href: "https://nais.io", tekst: "nais.io" }, { href: "https://docs.nais.io/persistence/kafka/", tekst: "docs.nais.io/kafka" }, { href: "https://aiven.io/kafka", tekst: "aiven.io/kafka" }]} />
</Layout>

<style>
  .p-hero { padding: 4rem 0; }
  .p-hero .container { display: grid; gap: 3rem; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 1rem; max-width: var(--prose); }
  .p-hero h1 { font-size: 3rem; letter-spacing: -0.01em; }
  .thesis { font-size: 1.375rem; font-weight: 600; line-height: 1.35; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .btn-quiet { background: transparent; color: var(--text); border: 1px solid var(--border-strong); }
  .btn-quiet:hover { background: var(--bg-subtle); color: var(--text); border-color: var(--text-subtle); }
  .p-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 0.75rem; }
  .p-meta .sep { color: var(--border-strong); }
  @media (min-width: 768px) { .p-hero { padding: 6rem 0; } .p-hero h1 { font-size: 3.5rem; } }
  @media (max-width: 639px) { .p-hero h1 { font-size: 2.5rem; } }
  @media (min-width: 1024px) { .p-hero .container { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  /* Før/etter-komposisjonen: to smale kolonner med en pil imellom */
  .ba { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: stretch; }
  .ba-col { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .ba-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-subtle); }
  .ba-arrow { display: flex; align-items: center; justify-content: center; color: var(--border-strong); transform: rotate(90deg); }
  @media (min-width: 560px) {
    .ba { grid-template-columns: minmax(0, 0.85fr) auto minmax(0, 1.15fr); gap: 1.25rem; }
    .ba-arrow { transform: none; }
  }

  .checklist { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; background: var(--bg-subtle); border: 1px dashed var(--border-strong); border-radius: var(--radius-l); padding: 1.25rem; height: 100%; }
  .checklist li { position: relative; padding-left: 1.5rem; font-size: 0.9375rem; line-height: 1.4; color: var(--text-subtle); transition: color 400ms ease, opacity 400ms ease; }
  .checklist li::before { content: ""; position: absolute; left: 0; top: 0.15em; width: 0.9rem; height: 0.9rem; border: 1px solid var(--border-strong); border-radius: var(--radius-s); }
  .checklist li::after { content: ""; position: absolute; left: 0.1rem; right: 0.1rem; top: 0.72em; height: 1px; background: var(--text-subtle); transform: scaleX(0); transform-origin: left; transition: transform 380ms ease; }
  .checklist li.struck { color: var(--border-strong); opacity: 0.7; }
  .checklist li.struck::after { transform: scaleX(1); }

  .manifest { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .manifest-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.625rem 1rem; border-bottom: 1px solid var(--border); background: var(--bg-subtle); }
  .manifest-bar .fname { font-family: var(--mono); font-size: 0.8125rem; color: var(--text-subtle); }
  .kind-chip { font-family: var(--mono); font-size: 0.75rem; padding: 0.125rem 0.5rem; border-radius: var(--radius-s); background: var(--tag-info-bg); color: var(--tag-info-text); white-space: nowrap; }
  .manifest pre { padding: 1.25rem 1rem; overflow-x: auto; font-family: var(--mono); font-size: 0.8125rem; line-height: 1.7; color: var(--text); }
  .yk { color: var(--accent); }
  .ys { color: var(--info-strong); }
  .yp { color: var(--text-subtle); }
  /* Tilgangslisten fremhevet: den er hele poenget med filen */
  .acl-hl { display: block; margin: 0.25rem -1rem -1.25rem; padding: 0.35rem 1rem 1.25rem 0.75rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }

  .ba-note { display: inline-flex; align-items: baseline; gap: 0.5rem; font-size: 0.9375rem; color: var(--info-strong); font-weight: 600; }
  .ba-note .check-icon { color: var(--accent); flex-shrink: 0; transform: translateY(2px); }

  .p-how { background: var(--bg-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .steps { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .step { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .step .num { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--info-strong); }
  .step h3 { font-size: 1.1875rem; }
  .step p { color: var(--text-subtle); font-size: 1.0625rem; }
  .p-how code, .p-secret code { font-family: var(--mono); font-size: 0.875em; background: var(--tint-info); color: var(--info-strong); padding: 0.0625rem 0.3125rem; border-radius: var(--radius-s); }

  .crd-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .kv { border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .kv-row { display: grid; grid-template-columns: minmax(16rem, auto) 1fr; }
  .kv-row + .kv-row { border-top: 1px solid var(--border); }
  .kv-row dt { font-family: var(--mono); font-size: 0.8125rem; padding: 0.75rem 1rem; background: var(--bg-subtle); color: var(--text); border-right: 1px solid var(--border); word-break: break-all; }
  .kv-row dd { font-size: 0.9375rem; padding: 0.75rem 1rem; color: var(--text-subtle); }
  .kv-row dd code { word-break: break-all; }
  @media (max-width: 639px) {
    .kv-row { grid-template-columns: 1fr; }
    .kv-row dt { border-right: none; border-bottom: 1px solid var(--border); }
  }

  .p-start { background: var(--bg-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .cmd { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .cmd pre { padding: 1.25rem 1rem; overflow-x: auto; font-family: var(--mono); font-size: 0.875rem; line-height: 1.8; color: var(--text); }
  .cmd .cm { color: var(--text-subtle); }

  .p-adopt { background: var(--tint-info); border-top: 1px solid var(--border); }
  .cols { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 2rem; display: flex; flex-direction: column; gap: 0.875rem; }
  .panel h3 { font-size: 1.25rem; }
  .panel ul { list-style: none; display: flex; flex-direction: column; gap: 0.625rem; }
  .panel li { display: flex; gap: 0.625rem; align-items: baseline; color: var(--text-subtle); font-size: 1.0625rem; }
  .panel li code { font-family: var(--mono); font-size: 0.85em; background: var(--tint-info); color: var(--info-strong); padding: 0.0625rem 0.3125rem; border-radius: var(--radius-s); }
  .panel .check-icon, .adopter-note .check-icon { color: var(--accent); flex-shrink: 0; transform: translateY(2px); }
  .panel .fine { font-size: 0.9375rem; color: var(--text-subtle); }
  .adopter-note { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: var(--info-strong); font-weight: 600; }
</style>

<script is:inline>
  // Saksgangen strykes ut ett punkt om gangen ved lasting — filen erstatter
  // køen. Med prefers-reduced-motion vises sluttbildet (alt strøket) direkte.
  (function () {
    var items = document.querySelectorAll("#checklist li");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach(function (l) { l.classList.add("struck"); });
    } else {
      items.forEach(function (l, i) {
        setTimeout(function () { l.classList.add("struck"); }, 650 + i * 420);
      });
    }
  })();
</script>
