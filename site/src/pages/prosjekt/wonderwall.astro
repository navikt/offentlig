---
import Layout from "../../layouts/Layout.astro";
import Icons from "../../components/Icons.astro";
import ProsjektHeader from "../../components/ProsjektHeader.astro";
import ProsjektFooter from "../../components/ProsjektFooter.astro";

import generated from "../../data/generated.json";

/* Bespoke landingsside (PRD: håndlaget, aldri generert fra mal).
   Motiv: forespørselens reise gjennom sidevognen — heltebildet er selve stien. */
const data = (generated.repos as any)["nais/wonderwall"];
---

<Layout
  title="wonderwall — sidevognen som tar innloggingen for deg"
  description="En OpenID Connect-sidevogn som tar hele innloggingen mot leverandøren, slik at applikasjonen din slipper å lære OAuth2. Åpen kildekode fra Nav."
>
  <ProsjektHeader navn="wonderwall" />
  <main id="hoved">
    <Icons />

    <section class="p-hero">
      <div class="container">
        <div class="hero-copy">
          <p class="eyebrow">Fra Nais-plattformen · Bygd for gjenbruk</p>
          <h1>wonderwall</h1>
          <p class="thesis">Applikasjonen din trenger aldri å lære OAuth2.</p>
          <p class="ingress">wonderwall er en reverse proxy som spiller rollen som OpenID&#8209;Connect&#8209;klient, vanligvis som en sidevogn ved siden av applikasjonen din. Den tar hele innloggingen mot identitetsleverandøren og sender forespørselen videre til appen med brukerens token påkoblet.</p>
          <div class="cta-row">
            <a class="btn" href="https://github.com/nais/wonderwall">Kom i gang på GitHub<svg class="ext-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-external" /></svg></a>
            <a class="btn btn-quiet" href="#slik-virker-det">Slik virker det</a>
          </div>
          <p class="p-meta detail nums">
            {data?.language && (
              <>
                <span><span class="lang-dot" style={`background:${data.languageColor ?? "var(--border-strong)"}`}></span>{data.language}</span>
                <span class="sep">·</span>
              </>
            )}
            <span>MIT-lisens</span>
            <span class="sep">·</span>
            <span>Kubernetes-sidevogn</span>
          </p>
        </div>

        <figure class="journey" aria-label="Forespørselens reise: Nettleseren treffer /oauth2/login, wonderwall håndterer OpenID Connect mot leverandøren, og applikasjonen din får forespørselen med brukerens token påkoblet.">
          <div class="journey-inner">
            <div class="rail" aria-hidden="true"><span class="packet" id="packet"></span></div>
            <ol class="stations" id="stations">
              <li class="station">
                <span class="node"></span>
                <p class="st-name">Nettleseren</p>
                <p class="st-line">Sender brukeren til <code>/oauth2/login</code></p>
              </li>
              <li class="station">
                <span class="node"></span>
                <p class="st-name">wonderwall</p>
                <p class="st-line">Går Authorization&nbsp;Code&#8209;flyten med leverandøren</p>
              </li>
              <li class="station">
                <span class="node"></span>
                <p class="st-name">Applikasjonen din</p>
                <p class="st-line">Får forespørselen med <code>Authorization: Bearer</code></p>
              </li>
            </ol>
          </div>
          <figcaption class="j-cap detail">Oppkoblingen skjer én gang. Appen ser bare en ferdig innlogget bruker.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section p-how" id="slik-virker-det">
      <div class="container">
        <div class="section-head">
          <h2>To måter å sette den opp på</h2>
          <p class="ingress">wonderwall snakker med enhver identitetsleverandør som følger OpenID Connect — den kjenner ikke leverandørens navn, bare protokollen. Velg oppsettet som passer perimeteren din.</p>
        </div>
        <div class="cols">
          <div class="panel">
            <p class="p-kicker">Standalone-modus <span class="mini-chip">standard</span></p>
            <h3>Én sidevogn per app</h3>
            <p>For zero&#8209;trust-oppsett der hver applikasjon har sin egen perimeter og sin egen klient. Sidevognen kjører rett ved siden av appen og beskytter akkurat den.</p>
          </div>
          <div class="panel">
            <p class="p-kicker">SSO-modus</p>
            <h3>Delt innlogging på ett domene</h3>
            <p>For felles autentisering på tvers av flere applikasjoner på et delt domene. Én server holder sesjonen, og appene deler den gjennom en SSO-proxy.</p>
          </div>
        </div>
        <p class="provider-note detail">Protokollstøtte: OpenID Connect Authorization Code Flow, med mål om å være OAuth&nbsp;2.1-kompatibel.</p>
      </div>
    </section>

    <section class="section p-why">
      <div class="container">
        <div class="section-head">
          <h2>Hvorfor en sidevogn?</h2>
          <p class="ingress">Fordi innlogging er den samme jobben uansett hvilket språk appen er skrevet i. Legger du den i en sidevogn, blir den gjort riktig én gang, og appen slipper å eie en eneste linje autentiseringskode.</p>
        </div>
        <div class="reason-grid">
          <div class="reason">
            <p class="r-num">01</p>
            <h3>Null autentiseringskode i appen</h3>
            <p>Ingen OAuth2-bibliotek, ingen callback-håndtering, ingen tokenvalidering å vedlikeholde. Appen leser brukeren fra en vanlig HTTP-forespørsel.</p>
          </div>
          <div class="reason">
            <p class="r-num">02</p>
            <h3>Ethvert språk, ethvert rammeverk</h3>
            <p>Sidevognen bryr seg ikke om appen er Go, Java, Node eller noe annet. Kontrakten er HTTP — det alle web-rammeverk allerede forstår.</p>
          </div>
          <div class="reason">
            <p class="r-num">03</p>
            <h3>Token påkoblet automatisk</h3>
            <p>Så lenge sesjonen er gyldig, legges brukerens access&#8209;token på hver forespørsel videre til appen som <code>Authorization: Bearer&nbsp;&lt;token&gt;</code>.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section p-endpoints">
      <div class="container">
        <div class="section-head">
          <h2>Endepunktene den legger til</h2>
          <p class="ingress">wonderwall eksponerer et sett stier under <code>/oauth2/</code>. Nettleseren og appen trenger stort sett bare de to øverste — resten håndterer sidevognen selv.</p>
        </div>
        <dl class="kv">
          <div class="kv-row"><dt>GET /oauth2/login</dt><dd>Starter OpenID Connect Authorization Code-flyten</dd></div>
          <div class="kv-row"><dt>GET /oauth2/logout</dt><dd>Lokal utlogging og videre til global/single-logout</dd></div>
          <div class="kv-row"><dt>GET /oauth2/logout/local</dt><dd>Kun lokal utlogging</dd></div>
          <div class="kv-row"><dt>GET /oauth2/session</dt><dd>Returnerer metadata om brukerens sesjon</dd></div>
          <div class="kv-row"><dt>POST /oauth2/session/refresh</dt><dd>Fornyer tokenene i sesjonen</dd></div>
          <div class="kv-row"><dt>GET /oauth2/session/forwardauth</dt><dd>Sjekker sesjonen og fornyer den ved behov</dd></div>
          <div class="kv-row"><dt>GET /oauth2/callback</dt><dd>Tar imot tilbakekallet fra identitetsleverandøren</dd></div>
          <div class="kv-row"><dt>GET /oauth2/logout/callback</dt><dd>Tar imot utloggings-tilbakekallet fra leverandøren</dd></div>
          <div class="kv-row"><dt>GET /oauth2/logout/frontchannel</dt><dd>Håndterer global utlogging initiert av leverandøren</dd></div>
        </dl>
      </div>
    </section>

    <section class="section p-start" id="kom-i-gang">
      <div class="container">
        <div class="section-head">
          <h2>Kom i gang</h2>
          <p class="ingress">Hent containeren, pek den på OpenID-leverandøren din og på appen den skal beskytte. Da tar sidevognen resten.</p>
        </div>
        <div class="start-cols">
          <figure class="codeblock" aria-label="Containerimage for wonderwall">
            <figcaption class="cb-bar">
              <span class="fname">container image</span>
              <button class="copy" type="button" data-copy="ghcr.io/nais/wonderwall">Kopier</button>
            </figcaption>
            <pre><code id="cb-image">ghcr.io/nais/wonderwall</code></pre>
          </figure>

          <figure class="codeblock" aria-label="Minimal konfigurasjon for standalone-modus">
            <figcaption class="cb-bar">
              <span class="fname">miljøvariabler (standalone)</span>
              <button class="copy" type="button" data-copy={`WONDERWALL_OPENID_CLIENT_ID=<klient-id>
WONDERWALL_OPENID_CLIENT_JWK=<privat-nøkkel-jwk>
WONDERWALL_OPENID_WELL_KNOWN_URL=https://leverandor/.well-known/openid-configuration
WONDERWALL_INGRESS=https://din-app.example.no
WONDERWALL_UPSTREAM_HOST=127.0.0.1:8080
WONDERWALL_BIND_ADDRESS=0.0.0.0:3000
WONDERWALL_ENCRYPTION_KEY=<openssl rand -base64 32>`}>Kopier</button>
            </figcaption>
            <pre><code><span class="ek">WONDERWALL_OPENID_CLIENT_ID</span>=<span class="ev">&lt;klient-id&gt;</span>
<span class="ek">WONDERWALL_OPENID_CLIENT_JWK</span>=<span class="ev">&lt;privat-nøkkel-jwk&gt;</span>
<span class="ek">WONDERWALL_OPENID_WELL_KNOWN_URL</span>=<span class="ev">https://leverandor/.well-known/openid-configuration</span>
<span class="ek">WONDERWALL_INGRESS</span>=<span class="ev">https://din-app.example.no</span>
<span class="ek">WONDERWALL_UPSTREAM_HOST</span>=<span class="ev">127.0.0.1:8080</span>
<span class="ek">WONDERWALL_BIND_ADDRESS</span>=<span class="ev">0.0.0.0:3000</span>
<span class="ek">WONDERWALL_ENCRYPTION_KEY</span>=<span class="ev">&lt;openssl rand -base64 32&gt;</span></code></pre>
          </figure>
        </div>
        <p class="start-note detail">Bruk <code>WONDERWALL_OPENID_CLIENT_SECRET</code> i stedet for <code>_CLIENT_JWK</code> om leverandøren din bruker client secret. For flere replikaer legger du til <code>WONDERWALL_REDIS_URI</code> som delt sesjonslager.</p>
      </div>
    </section>

    <section class="section p-adopt" id="ta-i-bruk">
      <div class="container">
        <div class="section-head">
          <h2>Ta den i bruk i din virksomhet</h2>
          <p class="ingress">wonderwall er en frittstående reverse proxy. Den er bygd på Nais-plattformen, men vet ingenting om Nav — alt den trenger er en OpenID-leverandør og et sted å kjøre en container.</p>
        </div>
        <div class="cols">
          <div class="panel">
            <h3>Det du trenger</h3>
            <ul>
              <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>En identitetsleverandør som følger OpenID Connect</li>
              <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Et sted å kjøre en container, gjerne som sidevogn ved siden av appen</li>
              <li><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>En håndfull miljøvariabler — det er hele grensesnittet</li>
            </ul>
          </div>
          <div class="panel">
            <h3>Det du kan forvente</h3>
            <p class="fine">MIT-lisensiert og fritt å bruke. Vi lover ingen support-SLA, men issues og pull requests er velkomne — koden driftes daglig i Nav, så den blir vedlikeholdt uansett.</p>
            <p class="fine">Si gjerne fra hvis du tar den i bruk. Det er slik vi vet at det åpne arbeidet virker.</p>
            <p class="adopter-note"><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-check" /></svg>Kjører hvor som helst du kan kjøre en container</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <ProsjektFooter repo="nais/wonderwall" lenker={[{ href: "https://nais.io", tekst: "nais.io" }, { href: "https://doc.nais.io/auth/", tekst: "doc.nais.io" }]} />
</Layout>

<style>
  .p-hero { padding: 4rem 0; }
  .p-hero .container { display: grid; gap: 3rem; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 1rem; max-width: var(--prose); }
  .p-hero h1 { font-size: 3rem; letter-spacing: -0.01em; }
  .thesis { font-size: 1.375rem; font-weight: 600; line-height: 1.35; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .btn-quiet { background: transparent; color: var(--text); border: 1px solid var(--border-strong); }
  .btn-quiet:hover { background: var(--bg-subtle); color: var(--text); border-color: var(--text-subtle); }
  .p-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 0.75rem; }
  .p-meta .sep { color: var(--border-strong); }
  @media (min-width: 768px) { .p-hero { padding: 6rem 0; } .p-hero h1 { font-size: 3.5rem; } }
  @media (max-width: 639px) { .p-hero h1 { font-size: 2.5rem; } }
  @media (min-width: 1024px) { .p-hero .container { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  /* Heltebildet: reisen som en horisontal sti med tre stasjoner og en pakke som vandrer */
  .journey { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 2rem 1.5rem 1.5rem; }
  .journey-inner { position: relative; }
  .rail { position: absolute; left: 0; right: 0; top: 0.5rem; height: 2px; background: var(--border); border-radius: 2px; }
  .packet { position: absolute; top: 50%; left: 16.667%; width: 0.75rem; height: 0.75rem; margin: -0.375rem 0 0 -0.375rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); transition: left 750ms cubic-bezier(0.65, 0, 0.35, 1); }
  .stations { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .station { display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: 1.25rem; position: relative; }
  .node { width: 0.875rem; height: 0.875rem; border-radius: 50%; background: var(--surface); border: 2px solid var(--border-strong); position: absolute; top: 0.11rem; left: 50%; margin-left: -0.4375rem; transition: background-color 300ms ease, border-color 300ms ease, box-shadow 300ms ease; }
  .station.active .node { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .st-name { font-weight: 600; font-size: 1rem; margin-top: 0.75rem; color: var(--text-subtle); transition: color 300ms ease; }
  .station.active .st-name { color: var(--text); }
  .st-line { font-size: 0.8125rem; line-height: 1.4; color: var(--text-subtle); margin-top: 0.25rem; }
  .st-line code, .journey code { font-family: var(--mono); font-size: 0.9em; background: var(--tint-info); color: var(--info-strong); padding: 0.0625rem 0.25rem; border-radius: var(--radius-s); word-break: break-word; }
  .j-cap { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border); text-align: center; }
  @media (max-width: 520px) {
    .rail { display: none; }
    .stations { grid-template-columns: 1fr; gap: 0.75rem; }
    .station { flex-direction: row; align-items: flex-start; text-align: left; padding-top: 0; padding-left: 1.5rem; gap: 0.5rem; }
    .node { position: absolute; top: 0.35rem; left: 0; margin-left: 0; }
    .st-name { margin-top: 0; }
  }

  .p-how { background: var(--bg-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .cols { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 2rem; display: flex; flex-direction: column; gap: 0.875rem; }
  .panel h3 { font-size: 1.25rem; }
  .p-kicker { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--info-strong); display: flex; align-items: center; gap: 0.5rem; }
  .mini-chip { font-size: 0.6875rem; letter-spacing: 0.02em; text-transform: none; font-weight: 600; padding: 0.0625rem 0.4375rem; border-radius: var(--radius-s); background: var(--tint-info); color: var(--info-strong); }
  .panel p { color: var(--text-subtle); }
  .provider-note { margin-top: 1.5rem; }
  .provider-note code, .p-why code, .p-endpoints code, .p-start .start-note code { font-family: var(--mono); font-size: 0.875em; background: var(--tint-info); color: var(--info-strong); padding: 0.0625rem 0.3125rem; border-radius: var(--radius-s); }

  .reason-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .reason-grid { grid-template-columns: repeat(3, 1fr); } }
  .reason { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .reason .r-num { font-family: var(--mono); font-size: 1rem; font-weight: 600; color: var(--accent); }
  .reason h3 { font-size: 1.125rem; }
  .reason p { color: var(--text-subtle); font-size: 1.0625rem; }

  .p-endpoints { background: var(--bg-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .kv { border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; background: var(--surface); }
  .kv-row { display: grid; grid-template-columns: minmax(16rem, auto) 1fr; }
  .kv-row + .kv-row { border-top: 1px solid var(--border); }
  .kv-row dt { font-family: var(--mono); font-size: 0.8125rem; padding: 0.75rem 1rem; background: var(--bg-subtle); color: var(--text); border-right: 1px solid var(--border); word-break: break-all; }
  .kv-row dd { font-size: 0.9375rem; padding: 0.75rem 1rem; color: var(--text-subtle); }
  @media (max-width: 639px) {
    .kv-row { grid-template-columns: 1fr; }
    .kv-row dt { border-right: none; border-bottom: 1px solid var(--border); }
  }

  .start-cols { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 900px) { .start-cols { grid-template-columns: 0.8fr 1.2fr; } }
  .codeblock { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-l); overflow: hidden; }
  .cb-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.75rem 0.5rem 1rem; border-bottom: 1px solid var(--border); background: var(--bg-subtle); }
  .cb-bar .fname { font-family: var(--mono); font-size: 0.8125rem; color: var(--text-subtle); }
  .copy { font: inherit; font-size: 0.75rem; font-weight: 600; font-family: var(--mono); cursor: pointer; padding: 0.1875rem 0.625rem; border-radius: var(--radius-s); border: 1px solid var(--border-strong); background: var(--surface); color: var(--text-subtle); transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease; }
  .copy:hover { background: var(--bg-subtle); color: var(--text); border-color: var(--text-subtle); }
  @media (max-width: 767px) { .copy { min-height: 44px; } }
  .copy.done { color: var(--accent); border-color: var(--accent); }
  .codeblock pre { padding: 1rem; overflow-x: auto; font-family: var(--mono); font-size: 0.8125rem; line-height: 1.75; color: var(--text); }
  .ek { color: var(--accent); }
  .ev { color: var(--text-subtle); }
  .start-note { margin-top: 1.5rem; max-width: var(--prose); }

  .p-adopt { background: var(--tint-info); border-top: 1px solid var(--border); }
  .p-adopt .panel ul { list-style: none; display: flex; flex-direction: column; gap: 0.625rem; }
  .p-adopt .panel li { display: flex; gap: 0.625rem; align-items: baseline; color: var(--text-subtle); font-size: 1.0625rem; }
  .p-adopt .check-icon, .adopter-note .check-icon { color: var(--accent); flex-shrink: 0; transform: translateY(2px); }
  .p-adopt .panel .fine { font-size: 0.9375rem; color: var(--text-subtle); }
  .adopter-note { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: var(--info-strong); font-weight: 600; }
</style>

<script is:inline>
  // Reisen spilles av én gang ved lasting: pakken vandrer stasjon til stasjon og hviler.
  // Reduced-motion viser den fullførte stien direkte.
  (function () {
    var packet = document.getElementById("packet");
    var stations = Array.prototype.slice.call(document.querySelectorAll("#stations .station"));
    var stops = [16.667, 50, 83.333];
    if (!packet || !stations.length) return;

    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      stations.forEach(function (s) { s.classList.add("active"); });
      packet.style.left = stops[stops.length - 1] + "%";
      return;
    }

    stations[0].classList.add("active");
    stops.forEach(function (pos, i) {
      setTimeout(function () {
        packet.style.left = pos + "%";
        stations[i].classList.add("active");
      }, 500 + i * 900);
    });
  })();

  // Kopier-knappene i «Kom i gang»
  (function () {
    var buttons = document.querySelectorAll(".copy");
    Array.prototype.forEach.call(buttons, function (btn) {
      btn.addEventListener("click", function () {
        var text = btn.getAttribute("data-copy") || "";
        var done = function () {
          var original = btn.textContent;
          btn.textContent = "Kopiert";
          btn.classList.add("done");
          setTimeout(function () { btn.textContent = original; btn.classList.remove("done"); }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(function () {});
        }
      });
    });
  })();
</script>
